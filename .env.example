# Use separate random values with at least 32 UTF-8 bytes.
AI_CONSENT_SIGNING_SECRET=
PUSH_SIGNING_SECRET=

# Browser-safe Supabase values. Use a publishable key, never service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Only the allowlisted model below is accepted by the server.
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
# Use a dedicated budgeted key in production; Vercel OIDC is a keyless alternative.
AI_GATEWAY_API_KEY=

# Generate this pair together; never expose VAPID_PRIVATE_KEY in client code.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://fall-2026-quest.vercel.app
